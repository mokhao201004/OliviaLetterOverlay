<Window x:Class="OliviaLetterOverlay.FullLetterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="全信"
        WindowStyle="None"
        ResizeMode="NoResize"
        WindowState="Maximized"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        PreviewKeyDown="OnPreviewKeyDown">
    <Grid Background="#A8000000">
        <Viewbox x:Name="LetterViewbox" Width="930" Height="521" HorizontalAlignment="Center" VerticalAlignment="Center" Stretch="Uniform">
            <Grid Width="554" Height="310" ClipToBounds="True">
                <Image x:Name="PaperBackground" Stretch="Fill" />
                <ScrollViewer x:Name="ReplyScroll" VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled" PanningMode="VerticalOnly" Focusable="False" Background="Transparent" Margin="30,28,30,23">
                    <TextBlock x:Name="ReplyTextBlock" TextWrapping="Wrap" Text="" Foreground="#FF1E1A16" />
                </ScrollViewer>
                <TextBlock x:Name="DateText" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,24,10" Text="" Foreground="#FF46413A" />
            </Grid>
        </Viewbox>
        <Button x:Name="CloseButton" Width="40" Height="40" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,14,14,0" Opacity="0.72" Background="#CC202228" BorderBrush="#FF4D5058" BorderThickness="1" Foreground="#FFF0EEEB" FontFamily="Segoe MDL2 Assets" FontSize="15" Content="&#xE8BB;" Cursor="Hand" Click="CloseButton_OnClick" ToolTip="退出全屏（Esc）">
            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="20" /></Style></Button.Resources>
        </Button>
    </Grid>
</Window>
