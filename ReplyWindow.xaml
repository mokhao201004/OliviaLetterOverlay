<Window x:Class="OliviaLetterOverlay.ReplyWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="660"
        Height="420"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None">
    <Border Background="#FF22242A" CornerRadius="12" Padding="20">
        <Grid Background="Transparent" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ItemsControl x:Name="ReplyPages">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Image Source="{Binding}" Width="600" Height="380" Stretch="Uniform" Margin="0,0,0,10" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Button HorizontalAlignment="Right"
                    VerticalAlignment="Top"
                    Width="30"
                    Height="30"
                    Margin="0,0,8,0"
                    Background="Transparent"
                    BorderBrush="Transparent"
                    Content="×"
                    Cursor="Hand"
                    FontFamily="Segoe UI"
                    FontSize="25"
                    Foreground="#FFAEB1B7"
                    Padding="0,-4,0,0"
                    Click="CloseButton_OnClick" />
        </Grid>
    </Border>
</Window>
