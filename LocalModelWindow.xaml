<Window x:Class="OliviaLetterOverlay.LocalModelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="565"
        Height="635"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <Border Background="#FF202228" BorderBrush="#FF3C3F47" BorderThickness="1" CornerRadius="12">
        <Grid Margin="26,23">
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <Grid Background="Transparent" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                        <StackPanel>
                            <TextBlock Text="本地模型" Foreground="#FFF2F0EC" FontFamily="Microsoft YaHei UI" FontSize="21" FontWeight="Bold" />
                            <TextBlock Margin="0,7,0,0" Text="模型由已安装的 Ollama 在本机运行；下载后不需要 API Key。" Foreground="#FFB9BBC1" FontFamily="Microsoft YaHei UI" FontSize="13" TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Width="30" Height="30" HorizontalAlignment="Right" Background="Transparent" BorderBrush="Transparent" Foreground="#FFAEB1B7" FontFamily="Segoe MDL2 Assets" FontSize="14" Content="&#xE8BB;" Cursor="Hand" Click="CloseButton_OnClick" />
                    </Grid>

                    <Border Margin="0,18,0,0" Padding="13,11" Background="#FF191B20" BorderBrush="#FF3E4149" BorderThickness="1" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="本机建议" Foreground="#FFE7E4E0" FontFamily="Microsoft YaHei UI" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock x:Name="DeviceRecommendationText" Margin="0,4,0,0" Foreground="#FF9FA3AA" FontFamily="Microsoft YaHei UI" FontSize="12" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <TextBlock Margin="0,17,0,0" Text="Ollama 安装目录（可选）" Foreground="#FFE1DFDC" FontFamily="Microsoft YaHei UI" FontSize="13" FontWeight="SemiBold" />
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="86" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="InstallDirectoryBox" Height="39" Padding="10,0" Background="#FF15171B" BorderBrush="#FF50535C" BorderThickness="1" Foreground="#FFF0EEEB" FontFamily="Consolas" FontSize="12" VerticalContentAlignment="Center" />
                        <Button Grid.Column="1" Height="39" Margin="9,0,0,0" Background="#FF34363D" BorderBrush="#FF565963" BorderThickness="1" Foreground="#FFF0EEEB" Content="浏览…" Cursor="Hand" FontFamily="Microsoft YaHei UI" Click="BrowseInstallDirectoryButton_OnClick">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="7" /></Style></Button.Resources>
                        </Button>
                    </Grid>
                    <TextBlock Margin="1,6,0,0" Text="留空使用官方默认位置。开始安装时，所选目录会自动填入 Ollama 安装向导。" Foreground="#FF9FA3AA" FontFamily="Microsoft YaHei UI" FontSize="12" TextWrapping="Wrap" />

                    <TextBlock Margin="0,17,0,0" Text="选择模型" Foreground="#FFE1DFDC" FontFamily="Microsoft YaHei UI" FontSize="13" FontWeight="SemiBold" />
                    <ComboBox x:Name="ModelPicker" Style="{StaticResource DarkComboBox}" Height="40" Margin="0,7,0,0" Foreground="#FFF0EEEB" FontFamily="Microsoft YaHei UI" FontSize="13" DisplayMemberPath="Title" SelectionChanged="ModelPicker_OnSelectionChanged" />
                    <TextBlock x:Name="ModelDetailText" Margin="1,7,0,0" Foreground="#FF9FA3AA" FontFamily="Microsoft YaHei UI" FontSize="12" TextWrapping="Wrap" />

                    <StackPanel Margin="0,17,0,0" Orientation="Horizontal">
                        <Button x:Name="DownloadButton" Width="118" Height="36" Background="#FF34363D" BorderBrush="#FF565963" BorderThickness="1" Foreground="#FFF0EEEB" Content="下载所选模型" Cursor="Hand" FontFamily="Microsoft YaHei UI" FontWeight="SemiBold" Click="DownloadButton_OnClick">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="18" /></Style></Button.Resources>
                        </Button>
                        <Button Width="94" Height="36" Margin="9,0,0,0" Background="Transparent" BorderBrush="#FF565963" BorderThickness="1" Foreground="#FFD8D8D8" Content="刷新已安装" Cursor="Hand" FontFamily="Microsoft YaHei UI" Click="RefreshButton_OnClick">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="18" /></Style></Button.Resources>
                        </Button>
                        <Button x:Name="DownloadOllamaButton" Width="94" Height="36" Margin="9,0,0,0" Background="Transparent" BorderBrush="#FF565963" BorderThickness="1" Foreground="#FFD8D8D8" Content="下载 Ollama" Cursor="Hand" FontFamily="Microsoft YaHei UI" Click="DownloadOllamaButton_OnClick">
                            <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="18" /></Style></Button.Resources>
                        </Button>
                    </StackPanel>
                    <TextBlock x:Name="StatusText" Margin="1,10,0,0" Foreground="#FFB9BBC1" FontFamily="Microsoft YaHei UI" FontSize="12" TextWrapping="Wrap" />

                    <TextBlock Margin="0,17,0,0" Text="已安装模型" Foreground="#FFE1DFDC" FontFamily="Microsoft YaHei UI" FontSize="13" FontWeight="SemiBold" />
                    <ListBox x:Name="InstalledModelsBox" Height="103" Margin="0,7,0,0" Padding="5" Background="#FF15171B" BorderBrush="#FF50535C" BorderThickness="1" Foreground="#FFE7E4E0" FontFamily="Consolas" FontSize="12" SelectionChanged="InstalledModelsBox_OnSelectionChanged" />
                </StackPanel>
            </ScrollViewer>
            <StackPanel Grid.Row="1" Margin="0,17,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Width="72" Height="38" Background="Transparent" BorderBrush="#FF555861" BorderThickness="1" Foreground="#FFD8D8D8" Content="取消" Cursor="Hand" FontFamily="Microsoft YaHei UI" Click="CloseButton_OnClick">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="19" /></Style></Button.Resources>
                </Button>
                <Button Width="112" Height="38" Margin="10,0,0,0" Background="#FFE8DED4" BorderBrush="#FFE8DED4" BorderThickness="0" Foreground="#FF272526" Content="使用所选模型" Cursor="Hand" FontFamily="Microsoft YaHei UI" FontWeight="SemiBold" Click="UseModelButton_OnClick">
                    <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="19" /></Style></Button.Resources>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
