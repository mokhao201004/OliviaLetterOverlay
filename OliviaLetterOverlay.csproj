<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>1.0.1</Version>
    <FileVersion>1.0.1.0</FileVersion>
    <InformationalVersion>1.0.1</InformationalVersion>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj-next\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <None Remove="Assets\composer-paper.png" />
    <None Remove="Assets\letter-paper.png" />
    <None Remove="Assets\sent-paper.png" />
    <None Remove="Assets\portrait-stamp.png" />
    <Resource Include="Assets\composer-paper.png" />
    <Resource Include="Assets\letter-paper.png" />
    <Resource Include="Assets\sent-paper.png" />
    <Resource Include="Assets\portrait-stamp.png" />
  </ItemGroup>

</Project>


