<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <Version>1.3</Version>
    <FileVersion>1.3.0.0</FileVersion>
    <InformationalVersion>1.3</InformationalVersion>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\olivia.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefaultItemExcludes>$(DefaultItemExcludes);obj-next\**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Compile Remove="tests\**\*.cs" />
    <Compile Remove="installer\**\*.cs" />
    <Compile Remove="release\**\*.cs" />
    <Compile Remove="Updater\**\*.cs" />
    <Page Remove="tests\**\*.xaml" />
    <ApplicationDefinition Remove="tests\**\*.xaml" />
    <None Remove="Assets\composer-paper.png" />
    <None Remove="Assets\letter-paper.png" />
    <None Remove="Assets\letter-paper-olivia-inspired-v2.png" />
    <None Remove="Assets\sent-paper.png" />
    <None Remove="Assets\portrait-stamp.png" />
    <None Remove="Assets\music-star-icon-reference.png" />
    <None Remove="Assets\olivia-icon-preview.png" />
    <Resource Include="Assets\composer-paper.png" />
    <Resource Include="Assets\letter-paper.png" />
    <Resource Include="Assets\letter-paper-olivia-inspired-v2.png" />
    <Resource Include="Assets\sent-paper.png" />
    <Resource Include="Assets\portrait-stamp.png" />
    <Resource Include="Assets\music-star-icon-reference.png" />
    <Resource Include="Assets\olivia-icon-preview.png" />
    <Resource Include="Assets\olivia.ico" />
    <None Include="Assets\Fonts\ChillZhuo.ttf" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
    <None Include="Assets\Fonts\ChillZhuo-NOTICE.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" ExcludeFromSingleFile="true" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="Vortice.D3DCompiler" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.DXGI" Version="3.8.3" />
    <PackageReference Include="Vortice.MediaFoundation" Version="3.8.3" />
  </ItemGroup>

</Project>
