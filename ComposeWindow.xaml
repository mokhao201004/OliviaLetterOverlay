<Window x:Class="OliviaLetterOverlay.ComposeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="880"
        Height="660"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None"
        Closing="Window_OnClosing"
        PreviewKeyDown="Window_OnPreviewKeyDown">
    <Border Background="#FF22242A" CornerRadius="12">
        <Grid Margin="24">
            <Grid.RowDefinitions>
                <RowDefinition Height="31" />
                <RowDefinition Height="37" />
                <RowDefinition Height="478" />
                <RowDefinition Height="66" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="Transparent" MouseLeftButtonDown="Header_OnMouseLeftButtonDown">
                <TextBlock Text="写下你的感受" Foreground="#FFF1EFED" FontFamily="Microsoft YaHei UI" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right" Width="30" Height="30" Background="Transparent" BorderBrush="Transparent" Content="×" Cursor="Hand" FontFamily="Segoe UI" FontSize="25" Foreground="#FFAEB1B7" Padding="0,-4,0,0" Click="CloseButton_OnClick" />
            </Grid>

            <TextBlock x:Name="ComposeHintText" Grid.Row="1" Text="今天有什么想分享的？" TextTrimming="CharacterEllipsis" Foreground="#FFB6B8BD" FontFamily="Microsoft YaHei UI" FontSize="15" VerticalAlignment="Center" />

            <Grid Grid.Row="2">
                <Image x:Name="ComposerPaperImage" Stretch="Fill" />
                <TextBox x:Name="DraftBox" Margin="31,32,150,44" AcceptsReturn="True" Background="Transparent" BorderThickness="0" CaretBrush="#FF272522" FontFamily="KaiTi" FontSize="22" Foreground="#FF2F2C28" HorizontalContentAlignment="Left" Padding="0" TextWrapping="Wrap" VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" />
            </Grid>

            <Grid Grid.Row="3">
                <TextBlock x:Name="StatusText" Foreground="#FFD1B9A2" FontFamily="Microsoft YaHei UI" FontSize="13" TextWrapping="Wrap" VerticalAlignment="Center" Visibility="Collapsed" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Width="69" Height="50" Margin="0,0,12,0" Background="#FF22242A" BorderBrush="#FF696C72" BorderThickness="1" Content="清空" Cursor="Hand" FontFamily="Microsoft YaHei UI" FontSize="16" Foreground="#FFF0EEEB" Click="ClearButton_OnClick">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="25" /></Style></Button.Resources>
                    </Button>
                    <Button x:Name="SendButton" Width="109" Height="50" Background="#FFE7DED5" BorderBrush="#FFE7DED5" BorderThickness="0" Content="寄出信件" Cursor="Hand" FontFamily="Microsoft YaHei UI" FontSize="16" Foreground="#FF2B2927" Click="SendButton_OnClick">
                        <Button.Resources><Style TargetType="Border"><Setter Property="CornerRadius" Value="25" /></Style></Button.Resources>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
